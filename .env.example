# Copiar a .env para desarrollo local (nunca commitear .env real)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Dominios permitidos por CORS, separados por coma
ALLOWED_ORIGINS=https://ipesfa-local.local

# Sitio WordPress del que se indexa el contenido
WP_BASE_URL=https://ipesfa-local.local
# Local by Flywheel usa certificado self-signed: dejar en false solo en local.
WP_VERIFY_SSL=false

FAQ_SIMILARITY_THRESHOLD=0.70
RAG_TOP_K=4
RATE_LIMIT=8 per minute
MAX_MESSAGE_LEN=500
POSTS_WINDOW_MONTHS=6

# Solo para testear el camino de fallback sin quemar cuota real de Gemini
FORCE_GEMINI_FAILURE=
